set +e
# ── 1. lint-staged — checks par type de fichier ───────────
npx lint-staged --quiet
LINT_EXIT=$?

# If lint-staged fails (and it's not just "no files matched" which usually exits 0 in newer versions,
# but we check just in case), we might want to block.
# However, if LINT_EXIT is non-zero, we should check if it's a real error.
if [ $LINT_EXIT -ne 0 ]; then
  echo "❌ lint-staged a échoué. Vérifiez les erreurs ci-dessus."
  exit $LINT_EXIT
fi

# ── 2. ktlint — formatage Kotlin ────────────────────────
if command -v ktlint > /dev/null 2>&1; then
  STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$' || true)
  if [ -n "$STAGED_KT" ]; then
    echo "🔍 ktlint --format sur les fichiers Kotlin stagés..."
    echo "$STAGED_KT" | xargs ktlint --format --relative 2>/dev/null
    echo "$STAGED_KT" | xargs ktlint --relative
    KTLINT_EXIT=$?
    if [ $KTLINT_EXIT -ne 0 ]; then
      echo "❌ ktlint: certains fichiers ont encore des erreurs."
      exit 1
    fi
    # Re-stage auto-formatted files
    git add $STAGED_KT
  fi
else
  echo "ℹ️  ktlint non installé — ignoré (brew install ktlint)"
fi

# ── 3. Rust — formatage + lint ──────────────────────────
RUST_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$RUST_STAGED" ]; then
  if command -v rustup > /dev/null 2>&1; then
    echo "🔍 cargo fmt --check + clippy..."
    REL=$(echo "$RUST_STAGED" | head -1 | xargs dirname | sed 's|/[^/]*$||' | grep -o '^core/' || echo "core")
    RUST_DIR="${REL%%/*}"
    if [ -f "$RUST_DIR/Cargo.toml" ]; then
      (cd "$RUST_DIR" && cargo fmt --check 2>/dev/null)
      FMT_EXIT=$?
      if [ $FMT_EXIT -ne 0 ]; then
        echo "❌ cargo fmt: formatage incorrect. Lancez 'cargo fmt' dans $RUST_DIR/."
        (cd "$RUST_DIR" && cargo fmt 2>/dev/null)
        echo "   → Auto-format appliqué. Re-stagez les fichiers."
        exit 1
      fi
      cargo clippy --all-targets -- -D warnings
      CLIPPY_EXIT=$?
      if [ $CLIPPY_EXIT -ne 0 ]; then
        echo "❌ cargo clippy a échoué. Corrigez les erreurs ci-dessus."
        exit $CLIPPY_EXIT
      fi
    fi
  else
    echo "ℹ️  rustup non trouvé — vérification Rust ignorée"
  fi
fi

# ── 4. Gitleaks — scan de secrets (si installé) ───────────
if command -v gitleaks > /dev/null 2>&1; then
  echo "🔍 Gitleaks scan..."
  gitleaks protect --staged -v
  GITLEAKS_EXIT=$?
  if [ $GITLEAKS_EXIT -ne 0 ]; then
    echo "❌ Gitleaks a détecté un secret — commit bloqué."
    exit 1
  fi
else
  echo "ℹ️  gitleaks non installé — ignoré (brew install gitleaks pour l'activer)"
fi

# ── 5. Fichiers volumineux ─────────────────────────────────
LARGE=$(git diff --cached --name-only | while read f; do
  [ -f "$f" ] && size=$(wc -c < "$f") && [ "$size" -gt 512000 ] && echo "$f ($((size/1024)) KB)"
done)
if [ -n "$LARGE" ]; then
  echo "❌ Fichier(s) trop volumineux stagé(s) (> 500 KB) :"
  echo "$LARGE"
  echo "   Les APK, keystore et binaires ne doivent pas être commités."
  exit 1
fi

# ── 6. Reminder éthique ───────────────────────────────────
echo ""
echo "⚠️  People Modeler — rappel éthique"
echo "   Utilisez cet outil avec bienveillance et responsabilité."
echo ""

exit $LINT_EXIT
