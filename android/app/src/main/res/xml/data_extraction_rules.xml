<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules for PeopleModeler
  Controls what is included/excluded from Android backup and cloud sync.

  allowBackup="false" in AndroidManifest is the primary guard.
  This file provides fine-grained control for future use and documents intent.
-->
<data-extraction-rules>

    <cloud-backup>
        <!-- Exclude everything by default — no user data leaves the device via cloud backup -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <device-transfer>
        <!-- Exclude everything from device-to-device transfer (e.g. via Google Drive backup) -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>

</data-extraction-rules>
