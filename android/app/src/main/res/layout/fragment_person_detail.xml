<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textPersonAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:text="🧑"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="@drawable/avatar_background"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/textPersonName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nom"
                            android:textColor="@color/colorText"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/textPersonRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rôle"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="13sp"/>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Motivations section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Motivations"
                android:textColor="@color/colorText"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/listMotivations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- OCEAN section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌊 Profil OCEAN"
                android:textColor="@color/colorText"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="O — Ouverture" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                        <ProgressBar android:id="@+id/barO" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:progressTint="@color/colorMotivation"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="C — Consciencieux" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                        <ProgressBar android:id="@+id/barC" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:progressTint="@color/colorMotivation"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="E — Extraversion" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                        <ProgressBar android:id="@+id/barE" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:progressTint="@color/colorMotivation"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="A — Agréabilité" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                        <ProgressBar android:id="@+id/barA" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:progressTint="@color/colorMotivation"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="N — Névrosisme" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                        <ProgressBar android:id="@+id/barN" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:progressTint="@color/colorBias"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Insight -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Analyser sous stress"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/colorSecondary"/>

            <TextView
                android:id="@+id/textInsightOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@color/colorCardBackground"
                android:lineSpacingMultiplier="1.5"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/colorSecondary"
        app:tint="@android:color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
