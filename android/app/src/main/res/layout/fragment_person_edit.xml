<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Avatar picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textSelectedEmoji"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="🧑"
                android:textSize="32sp"
                android:gravity="center"
                android:background="@drawable/avatar_background"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Changer l'avatar"
                app:backgroundTint="@color/colorCardBackground"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <!-- Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom *"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/colorText"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Role -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rôle (ex: Directeur, Client…)"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorText"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Context -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contexte (ex: Partenaire, Collègue…)"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorText"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tags -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tags (séparés par des virgules)"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorText"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes libres"
            android:layout_marginBottom="20dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/colorText"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- OCEAN sliders -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌊 Profil OCEAN (1–10)"
            android:textColor="@color/colorText"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"/>

        <!-- O -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="O — Ouverture" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
            <com.google.android.material.slider.Slider android:id="@+id/sliderO" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="5" app:thumbColor="@color/colorMotivation" app:trackColorActive="@color/colorMotivation"/>
            <TextView android:id="@+id/valO" android:layout_width="24dp" android:layout_height="wrap_content" android:text="5" android:textColor="@color/colorMotivation" android:gravity="center"/>
        </LinearLayout>
        <!-- C -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="C — Consciencieux" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
            <com.google.android.material.slider.Slider android:id="@+id/sliderC" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="5" app:thumbColor="@color/colorMotivation" app:trackColorActive="@color/colorMotivation"/>
            <TextView android:id="@+id/valC" android:layout_width="24dp" android:layout_height="wrap_content" android:text="5" android:textColor="@color/colorMotivation" android:gravity="center"/>
        </LinearLayout>
        <!-- E -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="E — Extraversion" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
            <com.google.android.material.slider.Slider android:id="@+id/sliderE" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="5" app:thumbColor="@color/colorMotivation" app:trackColorActive="@color/colorMotivation"/>
            <TextView android:id="@+id/valE" android:layout_width="24dp" android:layout_height="wrap_content" android:text="5" android:textColor="@color/colorMotivation" android:gravity="center"/>
        </LinearLayout>
        <!-- A -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="A — Agréabilité" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
            <com.google.android.material.slider.Slider android:id="@+id/sliderA" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="5" app:thumbColor="@color/colorMotivation" app:trackColorActive="@color/colorMotivation"/>
            <TextView android:id="@+id/valA" android:layout_width="24dp" android:layout_height="wrap_content" android:text="5" android:textColor="@color/colorMotivation" android:gravity="center"/>
        </LinearLayout>
        <!-- N -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="N — Névrosisme" android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
            <com.google.android.material.slider.Slider android:id="@+id/sliderN" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="5" app:thumbColor="@color/colorBias" app:trackColorActive="@color/colorBias"/>
            <TextView android:id="@+id/valN" android:layout_width="24dp" android:layout_height="wrap_content" android:text="5" android:textColor="@color/colorBias" android:gravity="center"/>
        </LinearLayout>

        <!-- Motivations -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Motivations"
            android:textColor="@color/colorMotivation"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/listMotivations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMotivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Ajouter une motivation"
            android:layout_marginBottom="20dp"
            app:backgroundTint="@color/colorMotivation"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <!-- Biases -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Biais cognitifs"
            android:textColor="@color/colorBias"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/listBiases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddBias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Ajouter un biais"
            android:layout_marginBottom="20dp"
            app:backgroundTint="@color/colorBias"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="space_between"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑 Supprimer"
                android:visibility="gone"
                app:backgroundTint="@color/colorBias"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Annuler"
                    android:layout_marginEnd="12dp"
                    app:backgroundTint="@color/colorCardBackground"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾 Enregistrer"
                    app:backgroundTint="@color/colorSecondary"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
