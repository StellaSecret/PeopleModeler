<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTotalPersons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧩 0 profil(s)"
            android:textColor="@color/colorText"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textAvgMotivations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Motivations : —"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textAvgBiases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠 Biais : —"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textTopMotivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 Motivation dominante : —"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/textEthicsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ À utiliser éthiquement"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:background="@color/colorCardBackground"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>
