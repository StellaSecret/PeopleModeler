<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/textPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 0 prédiction(s) en attente"
        android:textColor="@color/colorAccent"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPredictions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/emptyPredictions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔮 Aucune prédiction en attente.\nAjoutez-en depuis une fiche personne."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
