    <string name="insight_header_format">Sous \'%1$s\', %2$s est susceptible de :\n\n</string>
    <string name="insight_motivation_line">• Chercher à satisfaire : %1$s %2$s\n</string>
    <string name="insight_bias_line">• Être influencé par : %1$s %2$s\n</string>
    <string name="insight_neuroticism_line">• Réagir de façon émotionnelle\n</string>
    <string name="insight_conscientiousness_line">• Chercher à contrôler et planifier\n</string>
    <string name="insight_agreeableness_line">• Éviter le conflit, rechercher l\'harmonie\n</string>
    <string name="insight_extraversion_line">• Exprimer verbalement ses préoccupations\n</string>
    <string name="insight_observed_pattern">\n📌 Comportement observé : %s</string>
