# ── Android ───────────────────────────────────────────────
*.iml
.gradle/
android/local.properties
android/.idea/
android/app/build/
android/build/

# APK / AAB — never commit binaries
*.apk
*.aab

# Keystores — NEVER commit signing keys
*.keystore
*.jks
android/app/people-modeler-release.jks

# google-services.json — contains API keys, never commit the real one
android/app/google-services.json
# The template is safe to commit
!android/app/google-services.json.template

